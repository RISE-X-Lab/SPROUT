# Build artifacts
/target/
Cargo.lock
*.whl

# IDE
.idea/
.vscode/
*.swp
*.swo
.claude
.pytest_cache
.mypy_cache/
# Plots and throwaway scripts (CLAUDE.md)
/scratch/
# OS
.DS_Store
Thumbs.db

# Test artifacts
*.log

# Generated man pages (runtime)
/man/
runtime/sprout-runtime
# The ripgrep release grep_files embeds; `go generate ./...` downloads it
runtime/tools/ripgrep/*.tar.gz*
k8s-scaffold/gateway/k8s-gateway
__pycache__/
results/*

# Run artefacts: journals, resource ledger, extracted answers.
runs/

# Local credentials and experiment environments
.env
.env.*
.venv*/
*.pem
*.key

# Paper sources (ICLR submission), kept out of the code repository
/SPROUT_ICLR/
/SPROUT_ICLR.zip

# Regenerable paper figures (.claude/skills/paper-figures writes here)
/figures/

# Docs images outside docs/figures/ (gate/checks/docs_layout.py refuses them)
/docs/**/*.svg
/docs/**/*.pdf
/docs/**/*.png
!/docs/figures/*.svg
